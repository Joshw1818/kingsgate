# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Facebook Marketing API
FB_SYSTEM_USER_TOKEN=your-fb-system-user-token
FB_API_VERSION=v21.0

# Meta (KPI Tracker / Pillar 1) — System User token with ads_read on the ad accounts.
# Used by lib/sync/meta.ts → adset_metrics_daily. Not required for Pillar 0 (mock).
META_ACCESS_TOKEN=

# Protects /api/sync/* so only the Vercel cron (and you) can trigger a sync (Pillar 1).
CRON_SECRET=

# GoHighLevel
GHL_AGENCY_API_KEY=your-ghl-agency-api-key
GHL_API_BASE=https://services.leadconnectorhq.com
# KPI Tracker (Pillar 2) — agency key OR per-location Private Integration token.
GHL_API_KEY=

# Anthropic
ANTHROPIC_API_KEY=sk-ant-...

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
